NODE_ENV=development
PORT=4000

# Base locale lancee par docker compose (port hote 5433 pour eviter
# tout conflit avec un PostgreSQL deja installe sur la machine).
DATABASE_URL="postgresql://ankedu:ankedu_dev_password@localhost:5433/ankedu?schema=public"
SHADOW_DATABASE_URL="postgresql://ankedu:ankedu_dev_password@localhost:5433/ankedu_shadow?schema=public"

# Generer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# Compte administrateur cree par le seed
SEED_ADMIN_EMAIL=admin@ankedu.ci
SEED_ADMIN_PASSWORD=ChangeMoiEnProduction!2026
